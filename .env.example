SIMPLECLICK_ROOT=/opt/SimpleClick
SIMPLECLICK_CHECKPOINT_PATH=/opt/SimpleClick/weights/simpleclick_models/cocolvis_vit_huge.pth

# Expose the API on this host port.
SIMPLECLICK_PORT=8000

# Set this before exposing the instance publicly. Leave empty only for a
# private/network-isolated deployment.
SIMPLECLICK_API_KEY=replace-with-a-long-random-value

# auto selects CUDA when available. Use cpu only for debugging.
SIMPLECLICK_MODEL_DEVICE=auto
SIMPLECLICK_LOG_LEVEL=INFO
SIMPLECLICK_LOG_JSON=true
